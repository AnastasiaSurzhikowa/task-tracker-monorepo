@startuml
!theme plain

title Delegate Task — Sequence Diagram

participant "Client" as C
participant "TaskService" as T
participant "UserService" as U

C ->> T: POST /tasks/{taskId}/delegate?assigneeId=X
activate T

alt Задача не найдена
  T -->> C: 404 Not Found
  note right: без обращения к UserService

else Некорректный статус задачи (DONE)
  T -->> C: 400 Bad Request
  note right: без обращения к UserService

else Задача найдена и валидна
  T ->> U: GET /users/{assigneeId}
  activate U

  alt Пользователь не найден
    U -->> T: 404 Not Found
    deactivate U
    T -->> C: 404 Not Found
  else Пользователь найден
    U -->> T: 200 OK
    deactivate U
    T ->> T: обновить задачу (assigneeId)
    T -->> C: 200 OK
  end

deactivate T

@enduml
