@startuml
!theme plain

title task_service — таблица tasks (изолированная)

entity "tasks" as tasks {
  * id : BIGINT <<generated>>
  --
  title : VARCHAR(255)
  status : enum <<TODO | IN_PROGRESS | DONE>>
  creator_id : Long <<логическая ссылка на user (без FK)>>
  assignee_id : Long <<логическая ссылка на user (без FK, может быть null)>>
}

note right of tasks
  Изолированная база данных
  микросервиса task_service.
  creator_id и assignee_id — это
  логические ссылки на пользователей,
  НЕ ограниченные внешними ключами.
end note

@enduml
